---
import '../styles/site.css';
import { url } from '../data/photos';
import AboutFooter from '../components/AboutFooter.astro';

interface Props { title?: string; section?: 'gallery' | 'journal' | 'contact'; about?: boolean; description?: string; image?: string; pageClass?: string }
const { title = 'Marcus Rust – Photography', section, about = true, pageClass = '', description = 'Photography by Marcus Rust: astrophotography, nature and wildlife.', image } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://marcusrust.com');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const preview = image ?? new URL(url('/og-default.png'), siteUrl).href;
const nav = [['gallery', 'Gallery', '/'], ['journal', 'Journal', '/journal/'], ['contact', 'Contact', '/contact/']];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={pageUrl}>
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml">
  <link rel="icon" href={url('/favicon.ico')} sizes="48x48">
  <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')}>
  <meta property="og:site_name" content="Marcus Rust">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={preview}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||'dark'}catch(e){}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
  <header class="top">
    <a class="brand" href={url('/')}>Marcus Rust</a>
    <nav aria-label="Main">
      {nav.map(([key, label, href]) => (
        <a href={url(href)} aria-current={section === key ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <button class="sw" role="switch" aria-checked="true" aria-label="Dark mode">
      <span class="lbl">Dark</span><span class="track"></span>
    </button>
  </header>
  <main class={`page ${pageClass}`}><slot /></main>
  {about && <AboutFooter />}
  <footer class="foot">© {new Date().getFullYear()} Marcus Rust. All Rights Reserved.</footer>

  <script>
    const root = document.documentElement;
    const sw = document.querySelector('.sw');
    function paint() {
      const dark = root.dataset.theme !== 'light';
      sw.setAttribute('aria-checked', String(dark));
      sw.querySelector('.lbl').textContent = dark ? 'Dark' : 'Light';
    }
    sw.addEventListener('click', () => {
      const t = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = t;
      try { localStorage.setItem('theme', t); } catch (e) {}
      paint();
    });
    paint();
  </script>
</body>
</html>
