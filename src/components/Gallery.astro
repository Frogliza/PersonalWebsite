---
import { Image } from 'astro:assets';
import { url } from '../data/photos';

const { items, from = false, perRow = 4 } = Astro.props;

/* Photos per row on desktop (All Photos: 5, collections: 3). */
const rows = [];
for (let i = 0; i < items.length; i += perRow) rows.push(items.slice(i, i + perRow));
---
{items.length === 0 ? (
  <p class="empty">No photos here yet.</p>
) : (
  <div class="grid" style={`--n:${perRow}`}>
    {rows.map((row) => (
      <div class={row.length < perRow ? 'row last' : 'row'}>
        {row.map((it) => (
          <a class="tile" href={url(`/photo/${it.slug}/`) + (from ? '?from=all' : '')} aria-label={`View ${it.name}`} style={`--r:${it.lead.img.width / it.lead.img.height}`}>
            <Image src={it.lead.img} alt={it.name} width={Math.min(1200, it.lead.img.width)} />
          </a>
        ))}
      </div>
    ))}
  </div>
)}
