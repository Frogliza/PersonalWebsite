---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { entries } from '../../data/journal';
import { url } from '../../data/photos';
---
<Base section="journal" title="Journal – Marcus Rust">
  <h1 class="sr">Journal</h1>
  <ul class="cards">
    {entries.map((e) => (
      <li>
        <a class="card" href={url(`/journal/${e.slug}/`)}>
          {e.thumb
            ? <Image src={e.thumb} alt="" width={Math.min(800, e.thumb.width)} />
            : <span class="ph" aria-hidden="true"></span>}
          <span class="cap">{e.title}</span>
          <span class="blurb">{e.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
